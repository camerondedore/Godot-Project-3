[node name="NpcLumsden" parent="Npcs" parent_id_path=PackedInt32Array(1188647960) index="4" unique_id=92776748 node_paths=PackedStringArray("linkedObjects") instance=ExtResource("17_rxdae")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -29.6, 1, 20.35)
saveToWorldData = true
freezePlayer = true
linkedObjects = [NodePath("../../HubControl/Stage0")]

[node name="Dialogue1" type="Node" parent="Npcs/NpcLumsden" index="6" unique_id=170240534]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("19_ql14i")
dialogueText = "Hmmm...  Oh, hello!  I'm Lumsden, the gaffer of this hamlet.  You look like a ranger.  I met some up North before coming here."

[node name="Dialogue2" type="Node" parent="Npcs/NpcLumsden" index="7" unique_id=1148755087]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("20_47r21")
dialogueText = "It'd be most fortunate if we could enlist your help.  The rats moved into the surrounding forest and have been moving closer and closer to us."

[node name="Dialogue3" type="Node" parent="Npcs/NpcLumsden" index="8" unique_id=665668660]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("21_sjvko")
dialogueText = "We've posted pickets on the main road and built some munitions, but we don't have the means to take action outside of here."

[node name="Dialogue4" type="Node" parent="Npcs/NpcLumsden" index="9" unique_id=1014614764]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("22_7p7cv")
dialogueText = "The rats have found their way into an isolated area of homes and we've had to abandon it.  I need you to block their paths in by closing two gates."

[node name="Dialogue5" type="Node" parent="Npcs/NpcLumsden" index="10" unique_id=9128738]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("23_b1iuw")
dialogueText = "Wynn, the jackrabbit you've met, can tell you how to get there. She will meet you at the gate to the abandoned area.  Cross the bridge and head Northwest."

[node name="DialogueRepeating1" type="Node" parent="Npcs/NpcLumsden" index="11" unique_id=1895365993]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("24_qye8g")
dialogueText = "Wynn is waiting for you at the entrance to the abandoned area."
repeat = true

[node name="DialogueRepeating2" type="Node" parent="Npcs/NpcLumsden" index="12" unique_id=746413846]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("25_t7jcm")
dialogueText = "Once you cross the bridge, go right then left.  You're looking for the big gate."
repeat = true

