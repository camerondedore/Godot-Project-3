dialogueAudio = ExtResource("27_3p871")
dialogueText = "Shouldn't you be off by now?"

[node name="DialogueRepeating1" type="Node" parent="Npcs/NpcMobileWynn" index="9" unique_id=800709044]
script = ExtResource("18_5hgqg")
dialogueAudio = ExtResource("28_34tp6")
